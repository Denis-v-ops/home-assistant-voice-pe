# Copy these values into the ESPHome dashboard's secrets.yaml.
nova_gateway_url: wss://voice-gateway.home.arpa:8443/v1/device
nova_device_id: voice-pe-main
nova_device_psk: replace-with-the-same-random-256-bit-key-as-device_keys.json
nova_gateway_ca: |-
  -----BEGIN CERTIFICATE-----
  replace-with-caddys-exported-root-ca
  -----END CERTIFICATE-----
